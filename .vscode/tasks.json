{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Kill Ports 8000 and 3000",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "lsof -ti:8000 | xargs -r kill -9 && lsof -ti:3000 | xargs -r kill -9"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Start Backend",
            "type": "shell",
            "command": "uv",
            "args": ["run", "main.py"],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Start Frontend",
            "type": "shell",
            "command": "npm",
            "args": ["run", "dev"],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Start All (Kill Ports + Backend + Frontend)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Kill Ports 8000 and 3000",
                "Start Backend",
                "Start Frontend"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Start All Parallel (Kill Ports + Backend + Frontend)",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Kill Ports 8000 and 3000",
                "Start Backend",
                "Start Frontend"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
